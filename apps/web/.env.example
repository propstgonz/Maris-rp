# apps/web/.env.example — Fase 2 (Astro), ver docs/plan.md §2
#
# Copia a apps/web/.env para desarrollo local. En producción esta variable
# se fija en el entorno del contenedor (ver docker-compose.yml) — NUNCA en
# un fichero .env dentro de la imagen.

# URL interna (dentro de la red de Docker / red local) del mapServer.js ya
# existente — este proceso le reenvía la cookie de sesión para resolver
# quién eres (ver src/middleware.ts) y en dev también le hace de proxy para
# /auth, /api y /static (ver astro.config.mjs). NUNCA la URL pública — esta
# llamada es servidor-a-servidor, no pasa por Traefik.
API_INTERNAL_URL=http://localhost:3000

# Puerto en el que escucha este proceso (node adapter, modo standalone).
PORT=4321
