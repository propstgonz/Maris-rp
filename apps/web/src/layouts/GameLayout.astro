---
import '../styles/global.css';
import '../styles/legacy.css';
import { icon, discordMark } from '../lib/icons';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { user } = Astro.locals;
const isAdmin = Boolean(user?.isRolepriest);
const hasCharacter = Boolean(user?.hasCharacter);

const GAME_LINKS = [
  { path: '/', icon: 'crosshair', label: 'Mundo' },
  { path: '/personaje', icon: 'users', label: 'Personaje' },
  { path: '/guia', icon: 'book', label: 'Guía' },
];

const currentPath = Astro.url.pathname;
function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ricardana RP</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#030a05" />
    {user && <meta name="csrf-token" content={user.csrfToken} />}
    {user && <meta name="idle-logout-minutes" content={String(user.idleLogoutMinutes)} />}
  </head>
  <body class="worldmap-body">
    <header class="worldmap-topbar">
      <div class="worldmap-brand">
        <span class="worldmap-brand-mark" set:html={icon('map', { size: 18 })} />
        <span>Ricardana RP</span>
      </div>

      {user && hasCharacter && (
        <nav class="game-nav">
          {GAME_LINKS.map(link => (
            <a href={link.path} class={`game-nav-link ${isActive(link.path) ? 'active' : ''}`}>
              <span set:html={icon(link.icon, { size: 14 })} />
              <span>{link.label}</span>
            </a>
          ))}
        </nav>
      )}

      <div class="worldmap-session">
        {isAdmin && (
          <a class="worldmap-adminlink" href="/staff">
            <span set:html={icon('settings', { size: 14 })} /> Panel de administración
          </a>
        )}
        {user ? (
          <>
            <span class="worldmap-user">{user.username}</span>
            <a class="worldmap-logout" href="/auth/logout">Salir</a>
          </>
        ) : (
          <a class="worldmap-login" href="/auth/login">
            <span set:html={discordMark({ size: 14 })} /> Entrar con Discord
          </a>
        )}
      </div>
    </header>

    <main class="worldmap-main">
      <slot />
    </main>

    <div id="modalBackdrop" class="modal-backdrop"></div>
    <div id="toastContainer" class="toast-container"></div>
    <div id="confirmBackdrop" class="confirm-backdrop"></div>
  </body>
</html>

{user && (
  <script>

    import { initModalDismiss } from '../scripts/ui';
    import { initIdleSession } from '../scripts/idleSession';
    initModalDismiss();

    const idleLogoutMinutesEl = document.querySelector<HTMLMetaElement>('meta[name="idle-logout-minutes"]');
    if (idleLogoutMinutesEl) initIdleSession(Number(idleLogoutMinutesEl.content));

</script>
)}
