---
import '../styles/global.css';
import '../styles/legacy.css';
import { icon, discordMark } from '../lib/icons';

interface Props {
  title: string;
}

const { title } = Astro.props;
const sessionUser = Astro.locals.user;
const user = sessionUser?.isRolepriest ? sessionUser : null;

const DRAWER_LINKS = [
  { path: '/staff', icon: 'home', label: 'Inicio', accent: '#4fd18a' },
  { path: '/staff/players', icon: 'users', label: 'Jugadores', accent: '#6fc3d8' },
  { path: '/staff/audit-log', icon: 'scroll', label: 'Registro', accent: '#bfae8a' },
  { path: '/staff/terminal', icon: 'terminal', label: 'Terminal', accent: '#b58ee0' },
  { path: '/staff/backups', icon: 'save', label: 'Backups', accent: '#8f8fd8' },
  { path: '/staff/modmail-categorias', icon: 'folder', label: 'Categorías', accent: '#c9a86b' },
  { path: '/staff/docs', icon: 'book', label: 'Guía de Staff', accent: '#93a3b8' },
];

const currentPath = Astro.url.pathname;
function isActive(path: string): boolean {
  if (path === '/staff') return currentPath === '/staff' || currentPath === '/staff/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#030a05" />
    {user && <meta name="csrf-token" content={user.csrfToken} />}
    {user && <meta name="idle-logout-minutes" content={String(user.idleLogoutMinutes)} />}
    <title>{title} — Ricardana RP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  {user ? (
    <body class="app-body">
      <header class="topbar">
        <button id="menuToggle" class="btn-menu" title="Menú" aria-label="Abrir menú" set:html={icon('menu')} />
        <a href="/staff" class="topbar-title">
          <Fragment set:html={icon('home')} />
          Ricardana RP
        </a>

        <div class="topbar-user">
          <span id="liveClock" class="live-clock" title="Hora actual (del navegador)"></span>
          <span id="lastRefreshLabel" class="last-refresh" title="Última actualización de esta página — se refresca sola cada 30s, o al momento si otro Rolepriest cambia algo desde la web"></span>
          <span id="userLabel">
            <img class="player-avatar" src={`/api/discord-avatar/${user!.id}`} alt="" />
            {user!.username} · Rolepriest
          </span>
          <a href="/auth/logout" class="btn-logout">
            <Fragment set:html={icon('log-out', { size: 15 })} />
            Salir
          </a>
        </div>
      </header>

      <div id="drawerBackdrop" class="drawer-backdrop"></div>
      <nav id="drawer" class="drawer">
        <div class="drawer-header">
          <span class="drawer-brand">
            <Fragment set:html={icon('home')} />
            Ricardana RP
          </span>
          <button id="drawerClose" class="btn-icon" aria-label="Cerrar menú" set:html={icon('x')} />
        </div>
        <div class="drawer-links">
          {DRAWER_LINKS.map(link => (
            <a
              href={link.path}
              class={`drawer-link ${isActive(link.path) ? 'active' : ''}`}
              style={link.accent ? `--accent: ${link.accent}` : undefined}
            >
              <Fragment set:html={icon(link.icon)} />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </nav>

      <main class="app-main">
        <slot />
      </main>

      <div id="modalBackdrop" class="modal-backdrop"></div>
      <div id="toastContainer" class="toast-container"></div>
      <div id="confirmBackdrop" class="confirm-backdrop"></div>
    </body>
  ) : (
    <body class="login-body">
      <main class="login-card">
        <div class="login-emoji" set:html={icon('home', { size: 34 })} />
        <h1>Panel de administración</h1>
        {sessionUser ? (
          <Fragment>
            <p>Ricardana RP — este panel es solo para Rolepriests. La cuenta {sessionUser.username} no tiene ese rol.</p>
            <a class="btn-discord" href="/auth/logout">
              <Fragment set:html={icon('log-out', { size: 20 })} />
              Cerrar sesión
            </a>
          </Fragment>
        ) : (
          <Fragment>
            <p>Ricardana RP — panel de Rolepriests. Inicia sesión con tu cuenta de Discord.</p>
            <a class="btn-discord" href="/auth/login">
              <Fragment set:html={discordMark({ size: 20 })} />
              Entrar con Discord
            </a>
          </Fragment>
        )}
      </main>
    </body>
  )}
</html>

{user && (
  <script>
    import { initModalDismiss } from '../scripts/ui';
    import { initIdleSession } from '../scripts/idleSession';
    initModalDismiss();

    const idleLogoutMinutesEl = document.querySelector<HTMLMetaElement>('meta[name="idle-logout-minutes"]');
    if (idleLogoutMinutesEl) initIdleSession(Number(idleLogoutMinutesEl.content));

    const drawer = document.getElementById('drawer')!;
    const backdrop = document.getElementById('drawerBackdrop')!;
    const toggle = document.getElementById('menuToggle')!;
    const closeBtn = document.getElementById('drawerClose')!;

    function openDrawer() { drawer.classList.add('open'); backdrop.classList.add('open'); }
    function closeDrawer() { drawer.classList.remove('open'); backdrop.classList.remove('open'); }

    toggle.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    const clockEl = document.getElementById('liveClock');
    function tickClock() {
      if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    tickClock();
    setInterval(tickClock, 1000);
</script>
)}
