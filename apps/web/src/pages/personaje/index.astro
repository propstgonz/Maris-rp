---
import GameLayout from '../../layouts/GameLayout.astro';
import { icon } from '../../lib/icons';
import { requireCharacter } from '../../lib/auth';

const guard = requireCharacter(Astro);
if (guard instanceof Response) return guard;
---
<GameLayout title="Tu personaje">
  <div class="catalog-view">
    <div class="catalog-toolbar"><h2><Fragment set:html={icon('users')} />Tu personaje</h2></div>
    <div data-character-sheet-root>
      <div class="loading-state"><span class="spinner"></span> Cargando…</div>
    </div>
  </div>
</GameLayout>

<script>

  import { initCharacterSheet } from '../../scripts/characterSheet';
  const root = document.querySelector<HTMLElement>('[data-character-sheet-root]');
  if (root) initCharacterSheet(root);
</script>
