---
import GameLayout from '../layouts/GameLayout.astro';
import { icon, discordMark } from '../lib/icons';

const { user } = Astro.locals;
const hasCharacter = Boolean(user?.hasCharacter);
---
<GameLayout title="Ricardana RP">
  {!user && (
    <section class="worldmap-gate">
      <span class="worldmap-gate-icon" set:html={icon('map', { size: 40 })} />
      <h1>Ricardana RP</h1>
      <p>
        Entra con tu cuenta de Discord para crear tu personaje y jugar.
      </p>
      <a class="worldmap-gate-btn" href="/auth/login">
        <span set:html={discordMark({ size: 16 })} /> Entrar con Discord
      </a>
      <p class="worldmap-gate-note">
        Necesitas estar en el servidor de Ricardana RP.
      </p>
    </section>
  )}

  {user && !hasCharacter && (
    <section class="worldmap-gate worldmap-gate-wide">
      <span class="worldmap-gate-icon" set:html={icon('users', { size: 40 })} />
      <h1>Crea tu personaje</h1>
      <p>Rellena esto para empezar a jugar — puedes editarlo más tarde.</p>
      <form data-character-create-form class="character-create-form">
        <div data-character-create-fields></div>
        <label>
          Foto de personaje (opcional)
          <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-character-create-photo>
        </label>
        <button type="submit" class="btn-primary">Crear personaje</button>
        <p class="hint" data-character-create-status role="status"></p>
      </form>
    </section>
  )}

  {user && hasCharacter && (
    <section class="worldmap-shell" data-worldmap-root>
      <div class="worldmap-canvas-wrap">
        <canvas data-worldmap-canvas></canvas>
        <div class="worldmap-status" data-worldmap-status>Cargando el mundo…</div>
        <div class="coord-hint" data-worldmap-coordhint></div>
        <button type="button" class="btn-primary worldmap-go-btn" data-worldmap-go-btn hidden></button>
      </div>
      <aside class="worldmap-side" data-worldmap-side></aside>
      <div class="form-panel" data-worldmap-attack-panel></div>
      <div class="form-panel" data-worldmap-craft-panel></div>
      <div class="form-panel" data-worldmap-trade-panel></div>
    </section>
  )}
</GameLayout>

<script>

  import { initWorldMap } from '../scripts/worldMap';
  import { initCharacterCreate } from '../scripts/characterCreate';

  const mapRoot = document.querySelector<HTMLElement>('[data-worldmap-root]');
  if (mapRoot) initWorldMap(mapRoot);

  const createForm = document.querySelector<HTMLElement>('[data-character-create-form]')?.closest('section');
  if (createForm) initCharacterCreate(createForm as HTMLElement);
</script>
