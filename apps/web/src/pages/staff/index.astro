---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { icon } from '../../lib/icons';
import { requireRolepriest } from '../../lib/auth';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

const cards = [
  { icon: 'users', label: 'Jugadores', path: '/staff/players' },
  { icon: 'scroll', label: 'Registro', path: '/staff/audit-log' },
  { icon: 'terminal', label: 'Terminal', path: '/staff/terminal' },
  { icon: 'save', label: 'Backups', path: '/staff/backups' },
  { icon: 'folder', label: 'Categorías', path: '/staff/modmail-categorias' },
  { icon: 'book', label: 'Guía de Staff', path: '/staff/docs' },
];
---
<BaseLayout title="Inicio">
  <div class="catalog-view">
    <div class="catalog-toolbar">
      <h2><Fragment set:html={icon('home')} />Inicio</h2>
    </div>
    <div class="dashboard-grid">
      {cards.map(c => (
        <a href={c.path} class="dashboard-card">
          <span class="dashboard-icon" set:html={icon(c.icon, { size: 22 })} />
          <span class="dashboard-label">{c.label}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
