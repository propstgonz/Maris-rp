---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { icon } from '../../../lib/icons';
import { requireRolepriest } from '../../../lib/auth';
import { jsonIsland } from '../../../lib/jsonIsland';
import { fetchNpcTypes, fetchItems, fetchTerrainTypes, fetchZones, fetchNpcGroupTypes, fetchFactions, MapServerApiError, type NpcType, type CatalogItem, type TerrainType, type Zone, type NpcGroupType, type Faction } from '../../../lib/mapServerApi';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

let npcs: NpcType[] = [];
let items: CatalogItem[] = [];
let terrainTypes: TerrainType[] = [];
let zones: Zone[] = [];
let npcGroupTypes: NpcGroupType[] = [];
let factions: Faction[] = [];
let loadError: string | null = null;
try {
  [npcs, items, terrainTypes, zones, npcGroupTypes, factions] = await Promise.all([
    fetchNpcTypes(Astro), fetchItems(Astro), fetchTerrainTypes(Astro), fetchZones(Astro), fetchNpcGroupTypes(Astro), fetchFactions(Astro),
  ]);
} catch (err) {
  loadError = err instanceof MapServerApiError ? err.message : 'No se pudo cargar el catálogo de NPCs.';
}
---
<BaseLayout title="NPCs">
  <section class="view catalog-view" data-npcs-root>
    <div data-npcs-list-page>
      <div class="catalog-toolbar">
        <h2><Fragment set:html={icon('skull')} />Catálogo de NPCs</h2>
        <div class="catalog-toolbar-actions">
          <button type="button" class="btn-secondary" data-npc-groups-btn><Fragment set:html={icon('users', { size: 15 })} />Grupos</button>
          <button type="button" class="btn-primary" data-npcs-new-btn>+ Nuevo NPC</button>
        </div>
      </div>
      {loadError ? (
        <p class="hint">❌ {loadError}</p>
      ) : (
        <div class="admin-table-wrap" data-npcs-table></div>
      )}
    </div>
    <div class="form-panel" data-npcs-form-panel></div>
    <div class="form-panel" data-npc-groups-panel></div>
  </section>
</BaseLayout>

<script type="application/json" id="npcs-bootstrap" is:inline set:html={jsonIsland({ npcs, items, terrainTypes, zones, npcGroupTypes, factions })} />
<script>
  import { initNpcCatalog } from '../../../scripts/npcCatalog';
  import type { NpcType, CatalogItem, TerrainType, Zone, NpcGroupType, Faction } from '../../../lib/mapServerApi';

  const root = document.querySelector<HTMLElement>('[data-npcs-root]');
  const bootstrapEl = document.getElementById('npcs-bootstrap');
  if (root && bootstrapEl) {
    const bootstrap = JSON.parse(bootstrapEl.textContent ?? '{}') as { npcs: NpcType[]; items: CatalogItem[]; terrainTypes: TerrainType[]; zones: Zone[]; npcGroupTypes: NpcGroupType[]; factions: Faction[] };
    initNpcCatalog(root, bootstrap.npcs ?? [], bootstrap.items ?? [], bootstrap.terrainTypes ?? [], bootstrap.zones ?? [], bootstrap.npcGroupTypes ?? [], bootstrap.factions ?? []);
  }
</script>
