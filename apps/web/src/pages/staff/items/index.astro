---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { icon } from '../../../lib/icons';
import { requireRolepriest } from '../../../lib/auth';
import { jsonIsland } from '../../../lib/jsonIsland';
import { fetchItems, fetchEffectTypes, fetchItemCategories, MapServerApiError, type CatalogItem, type EffectType, type ItemCategory } from '../../../lib/mapServerApi';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

let items: CatalogItem[] = [];
let effects: EffectType[] = [];
let categories: ItemCategory[] = [];
let loadError: string | null = null;
try {
  [items, effects, categories] = await Promise.all([fetchItems(Astro), fetchEffectTypes(Astro), fetchItemCategories(Astro)]);
} catch (err) {
  loadError = err instanceof MapServerApiError ? err.message : 'No se pudo cargar el catálogo de ítems.';
}
---
<BaseLayout title="Ítems">
  <section class="view catalog-view" data-items-root>
    <div data-items-list-page>
      <div class="catalog-toolbar">
        <h2><Fragment set:html={icon('package')} />Catálogo de ítems</h2>
        <div class="catalog-toolbar-actions">
          <button type="button" class="btn-secondary" data-items-categories-btn><Fragment set:html={icon('folder', { size: 15 })} />Categorías</button>
          <button type="button" class="btn-primary" data-items-new-btn>+ Nuevo ítem</button>
        </div>
      </div>
      {loadError ? (
        <p class="hint">❌ {loadError}</p>
      ) : (
        <>
          <div class="items-index-bar">
            <input type="text" placeholder="Buscar ítem por nombre…" data-items-search-input />
            <div class="category-chips" data-items-category-chips></div>
          </div>
          <div class="item-type-groups" data-items-table></div>
        </>
      )}
    </div>
    <div class="form-panel" data-items-form-panel></div>
    <div class="form-panel" data-items-categories-panel></div>
  </section>
</BaseLayout>

<script type="application/json" id="items-bootstrap" is:inline set:html={jsonIsland({ items, effects, categories })} />
<script>
  import { initItemCatalog } from '../../../scripts/itemCatalog';
  import type { CatalogItem, EffectType, ItemCategory } from '../../../lib/mapServerApi';

  const root = document.querySelector<HTMLElement>('[data-items-root]');
  const bootstrapEl = document.getElementById('items-bootstrap');
  if (root && bootstrapEl) {
    const bootstrap = JSON.parse(bootstrapEl.textContent ?? '{}') as { items: CatalogItem[]; effects: EffectType[]; categories: ItemCategory[] };
    initItemCatalog(root, bootstrap.items ?? [], bootstrap.effects ?? [], bootstrap.categories ?? []);
  }
</script>
