---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { icon } from '../../../lib/icons';
import { requireRolepriest } from '../../../lib/auth';
import { jsonIsland } from '../../../lib/jsonIsland';
import { fetchFactions, MapServerApiError, type Faction } from '../../../lib/mapServerApi';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

let factions: Faction[] = [];
let loadError: string | null = null;
try {
  factions = await fetchFactions(Astro);
} catch (err) {
  loadError = err instanceof MapServerApiError ? err.message : 'No se pudo cargar el catálogo de facciones.';
}
---
<BaseLayout title="Facciones">
  <section class="view catalog-view" data-facciones-root>
    <div data-facciones-list-page>
      <div class="catalog-toolbar">
        <h2><Fragment set:html={icon('flag')} />Catálogo de facciones</h2>
        <button type="button" class="btn-primary" data-facciones-new-btn>+ Nueva facción</button>
      </div>
      {loadError ? (
        <p class="hint">❌ {loadError}</p>
      ) : (
        <div class="admin-table-wrap" data-facciones-table></div>
      )}
    </div>
    <div class="form-panel" data-facciones-form-panel></div>
  </section>
</BaseLayout>

<script type="application/json" id="facciones-bootstrap" is:inline set:html={jsonIsland(factions)} />
<script>
  import { initFaccionCatalog } from '../../../scripts/faccionCatalog';
  import type { Faction } from '../../../lib/mapServerApi';

  const root = document.querySelector<HTMLElement>('[data-facciones-root]');
  const bootstrapEl = document.getElementById('facciones-bootstrap');
  if (root && bootstrapEl) {
    const factions = JSON.parse(bootstrapEl.textContent ?? '[]') as Faction[];
    initFaccionCatalog(root, factions);
  }
</script>
