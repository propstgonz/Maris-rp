---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { icon } from '../../../lib/icons';
import { requireRolepriest } from '../../../lib/auth';
import { fetchStaffDocs, ApiError } from '../../../lib/apiClient';
import { renderMarkdown } from '../../../scripts/docs';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

let html = '';
let loadError: string | null = null;
try {
  const { content } = await fetchStaffDocs(Astro);
  html = renderMarkdown(content);
} catch (err) {
  loadError = err instanceof ApiError ? err.message : 'No se pudo cargar la guía de Staff.';
}
---
<BaseLayout title="Guía de Staff">
  <div class="catalog-view">
    <div class="catalog-toolbar"><h2><Fragment set:html={icon('book')} />Guía de Staff</h2></div>
    {loadError ? (
      <p class="hint">{loadError}</p>
    ) : (
      <div class="docs-content" data-docs-root set:html={html} />
    )}
  </div>
</BaseLayout>
