---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { icon } from '../../../lib/icons';
import { requireRolepriest } from '../../../lib/auth';
import { jsonIsland } from '../../../lib/jsonIsland';
import { fetchEffectTypes, MapServerApiError, type EffectType } from '../../../lib/mapServerApi';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

let effects: EffectType[] = [];
let loadError: string | null = null;
try {
  effects = await fetchEffectTypes(Astro);
} catch (err) {
  loadError = err instanceof MapServerApiError ? err.message : 'No se pudo cargar el catálogo de estados.';
}
---
<BaseLayout title="Estados">
  <section class="view catalog-view" data-effects-root>
    <div data-effects-list-page>
      <div class="catalog-toolbar">
        <h2><Fragment set:html={icon('sparkles')} />Catálogo de estados</h2>
        <button type="button" class="btn-primary" data-effects-new-btn>+ Nuevo estado</button>
      </div>
      {loadError ? (
        <p class="hint">❌ {loadError}</p>
      ) : (
        <div class="admin-table-wrap" data-effects-table></div>
      )}
    </div>
    <div class="form-panel" data-effects-form-panel></div>
  </section>
</BaseLayout>

<script type="application/json" id="effects-bootstrap" is:inline set:html={jsonIsland(effects)} />
<script>
  import { initEffectCatalog } from '../../../scripts/effectCatalog';
  import type { EffectType } from '../../../lib/mapServerApi';

  const root = document.querySelector<HTMLElement>('[data-effects-root]');
  const bootstrapEl = document.getElementById('effects-bootstrap');
  if (root && bootstrapEl) {
    const effects = JSON.parse(bootstrapEl.textContent ?? '[]') as EffectType[];
    initEffectCatalog(root, effects);
  }
</script>
