---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { icon } from '../../../../lib/icons';
import { requireRolepriest } from '../../../../lib/auth';
import { fetchPlayer, ApiError, type PlayerRow } from '../../../../lib/apiClient';

const guard = requireRolepriest(Astro);
if (guard instanceof Response) return guard;

const { discordId } = Astro.params;

let player: PlayerRow | null = null;
let loadError: string | null = null;
try {
  player = await fetchPlayer(Astro, discordId!);
} catch (err) {
  loadError = err instanceof ApiError ? err.message : 'No se pudo cargar el jugador.';
}

const dateFmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' });
const formatDate = (value: string | null) => (value ? dateFmt.format(new Date(value)) : '—');
---
<BaseLayout title="Jugador">
  <div class="catalog-view">
    <div class="catalog-toolbar">
      <h2><Fragment set:html={icon('users')} />{player?.character_name ?? player?.username ?? 'Jugador'}</h2>
      <a class="btn-secondary" href="/staff/players"><Fragment set:html={icon('chevron-left', { size: 15 })} />Jugadores</a>
    </div>
    {loadError ? (
      <p class="hint">{loadError}</p>
    ) : player && (
      <div class="admin-table-wrap">
        <img class="player-avatar" src={player.avatar_url ?? `/api/discord-avatar/${player.discord_id}`} alt="" width="96" height="96" />
        <table class="admin-table">
          <tbody>
            <tr><th>Personaje</th><td>{player.character_name ?? '—'}</td></tr>
            <tr><th>Usuario</th><td>{player.username}</td></tr>
            <tr><th>Discord ID</th><td>{player.discord_id}</td></tr>
            <tr><th>Género</th><td>{player.gender ?? '—'}</td></tr>
            <tr><th>Estado</th><td>{player.is_alive ? 'Vivo' : 'Muerto'}</td></tr>
            <tr><th>Creado</th><td>{formatDate(player.character_created_at)}</td></tr>
            {!player.is_alive && <tr><th>Fallecido</th><td>{formatDate(player.died_at)}</td></tr>}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
