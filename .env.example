# ─── .env.example ────────────────────────────────────────────────────────────
# Copia este fichero a ".env" y rellena los valores reales.
# NUNCA subas el .env a Git (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
# Token del bot: Discord Developer Portal → Tu App → Bot → Token
DISCORD_TOKEN=tu_token_aqui

# Application ID: Discord Developer Portal → Tu App → General Information → Application ID
CLIENT_ID=tu_application_id_aqui

# Guild ID para desarrollo: activa el modo developer en Discord y copia el ID
# del servidor. Elimina esta línea (o déjala vacía) para registrar globalmente.
GUILD_ID=tu_guild_id_para_dev

# El bot registra sus Slash Commands en Discord automáticamente cada vez que
# arranca (ver services/commandDeployService.js) — ya no hace falta ejecutar
# `npm run deploy-commands` a mano. Pon esto a "false" para desactivarlo y
# volver al registro manual puntual.
# AUTO_DEPLOY_COMMANDS=false

# Con docker-compose.yml (ver ese fichero): DB_HOST/DB_PORT los fija el
# propio compose a nivel de servicio (maris-rpbot-bd:3306) y estas dos líneas se
# ignoran — solo importan si arrancas el bot fuera de Docker (npm run dev)
# contra una MySQL local o remota.
DB_HOST=127.0.0.1
DB_PORT=3306
# Usuario de aplicación (ver mysql-init/create-app-user.sh, que lo crea solo
# en la primera inicialización del volumen de MySQL) — NO "root". mysqldump
# (invocado por backupService.js para las copias de seguridad) usa este
# MISMO usuario, y el cliente real detrás de "mysqldump" en esta imagen es
# mariadb-dump, que no soporta el plugin caching_sha2_password por defecto
# de MySQL 8/root — con DB_USER=root los backups fallan en silencio. "propst"
# se crea siempre con mysql_native_password, compatible con ambos.
DB_USER=propst
# Una sola contraseña para todo: docker-compose.yml la reutiliza tal cual
# como MYSQL_ROOT_PASSWORD del contenedor de MySQL, y mysql-init/
# create-app-user.sh crea "propst" con esta misma contraseña — no hay una
# variable MYSQL_ROOT_PASSWORD aparte que rellenar.
DB_PASSWORD=cambia_esto

# ── Nginx (bucket de imágenes) ─────────────────────────────────────────────────
# URL PÚBLICA (accesible desde fuera, no un hostname interno de Docker) desde
# la que Discord descarga las imágenes servidas por el bucket (avatares, y lo
# que se añada después). docker-compose.yml YA NO fija esta variable — viene
# de aquí, así que el valor real que uses es el que se aplica.
#
# Setup con Traefik (ver docker-compose.yml → labels del servicio nginx):
#   1. Crea el registro DNS de tu subdominio → IP del servidor.
#   2. Usa ese mismo subdominio en el label traefik.http.routers.*.rule y aquí.
#   Ejemplo: NGINX_BASE_URL=https://rp-bucket.tudominio.com
#
# Setup sin Traefik (IP pública + puerto expuesto directo):
#   Vuelve a añadir `ports: - "8080:80"` al servicio nginx en docker-compose.yml.
#   Ejemplo: NGINX_BASE_URL=http://123.45.67.89:8080
#
# En ambos casos: NUNCA localhost ni un hostname interno de Docker (ej:
# "http://nginx/") — Discord no puede alcanzar ninguno de los dos. Si se
# configura mal, el bot lo detecta solo y omite la miniatura en vez de romper
# el comando (ver src/utils/publicUrl.js), pero entonces no verás imágenes.
NGINX_BASE_URL=https://rp-bucket.tudominio.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Nivel de log: error | warn | info | debug
LOG_LEVEL=info

# ── Backups (opcional) ────────────────────────────────────────────────────────
# Copias de seguridad rotativas vía mysqldump (ver src/services/backupService.js).
# Se guardan por defecto en ./data/backups, dentro del mismo bind mount que
# ./data en docker-compose.yml. Se ejecutan al arrancar el bot y según BACKUP_CRON.
#
# Expresión cron (formato node-cron), en UTC. Por defecto: 23:30 diario.
# BACKUP_CRON=30 23 * * *
#
# Cuántas copias conservar antes de borrar las más antiguas. Por defecto: 7.
# BACKUP_RETENTION=7
#
# Ruta absoluta alternativa para guardar los backups (ej: otro disco/punto de montaje).
# BACKUP_DIR=/app/data/backups

# ── Avisos de Staff (opcional) ────────────────────────────────────────────────
# Canal de Discord donde el bot avisa a Staff de problemas operativos urgentes
# (ej: si falla un backup, o cualquier warn/error del bot — ver utils/logger.js
# y utils/alerts.js — hay que enterarse ya, no al revisar logs).
STAFF_ALERTS_CHANNEL_ID=

# ── Modmail (opcional, pero necesario para que /personaje crear funcione del
#    todo) ─────────────────────────────────────────────────────────────────────
# Categoría de Discord donde se crea automáticamente el canal privado de
# Staff de cada personaje al usar /personaje crear (ver services/modmailService.js).
# Solo Staff ve estos canales; el jugador interactúa exclusivamente por MD.
# Discord limita a 50 canales por categoría, así que esta variable solo
# arranca la PRIMERA — para repartir los canales entre varias (según el
# servidor crece), un Staff registra categorías adicionales con
# /modmail-categoria crear en Discord o desde la web ("Categorías" en el
# menú), ver services/modmailCategoryService.js. También se puede fijar
# esta primera en caliente sin reiniciar el bot con el ajuste equivalente
# de settingsService (clave "modmail_category_id").
MODMAIL_CATEGORY_ID=

# ── Periódicos (Imprenta, opcional) ───────────────────────────────────────────
# Categoría de Discord donde /periodico abrir crea los canales-periódico.
# Es solo un FALLBACK: Staff puede (y debería) configurarla desde Discord con
# /periodico categoria, sin reiniciar el bot. Esta variable solo se usa si
# nunca se configuró así.
NEWSPAPER_CATEGORY_ID=

# ── Configuración (opcional) ──────────────────────────────────────────────────
# Ruta al config.json. Por defecto busca en process.cwd()/config.json.
# CONFIG_PATH=./config.json

# ── API del panel (src/apiServer.js, servicio Docker "maris-rp-api") ─────────
# Panel de Staff, con login por Discord OAuth2 —
# comprueba el mismo rol de Rolepriest que el propio bot (config.json).
# Reutiliza CLIENT_ID (arriba) como Client ID de la app de OAuth2.
#
# Client Secret: Discord Developer Portal → tu app → OAuth2 → "Reset Secret".
# Distinto del DISCORD_TOKEN del bot — no lo compartas.
DISCORD_CLIENT_SECRET=

# URL pública desde la que la gente entra al panel (mismo criterio que
# NGINX_BASE_URL: tiene que ser alcanzable desde fuera, nunca localhost ni un
# hostname interno de Docker) — también hay que añadir
# "${API_PUBLIC_URL}/auth/callback" a la lista de Redirects válidos en
# el Developer Portal (OAuth2 → Redirects), literalmente igual.
# Ejemplo: API_PUBLIC_URL=https://rp-map.tudominio.com
API_PUBLIC_URL=https://rp-map.tudominio.com

# Dominios que Traefik enruta a este proyecto (labels de docker-compose.yml).
# Sin protocolo ni barra final. PANEL_HOST es el host de API_PUBLIC_URL y
# BUCKET_HOST el de NGINX_BASE_URL. Tienen que ser distintos de los del bot
# antiguo si los dos corren a la vez en el mismo Traefik.
PANEL_HOST=rp-map.tudominio.com
BUCKET_HOST=rp-bucket.tudominio.com

# Secreto para firmar la cookie de sesión — cualquier cadena larga y
# aleatoria, ej. `openssl rand -hex 32`. Cámbialo y todo el mundo tendrá que
# volver a iniciar sesión.
API_SESSION_SECRET=
